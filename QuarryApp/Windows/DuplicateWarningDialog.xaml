<Window x:Class="QuarryApp.Windows.DuplicateWarningDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="File Already Downloaded — Quarry" Height="220" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Manrope, Segoe UI, sans-serif" FontSize="12">

    <Grid Margin="16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="File Already Exists" FontWeight="Bold" FontSize="13" Foreground="#1E293B" Margin="0,0,0,6"/>

        <TextBlock x:Name="MessageText" Grid.Row="1" Text="This file has already been downloaded and exists in your download directory. What would you like to do?" TextWrapping="Wrap" Foreground="#475569" FontSize="11.5" Margin="0,0,0,10"/>

        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" Padding="8,4" Margin="0,0,0,12" VerticalAlignment="Center">
            <TextBlock x:Name="FilePathText" Text="—" Foreground="#334155" FontSize="11" TextTrimming="CharacterEllipsis"/>
        </Border>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Overwrite" Width="85" Height="26" Click="Overwrite_Click" Background="#EF4444" Foreground="#FFFFFF" FontWeight="SemiBold" BorderThickness="0" Margin="0,0,6,0"/>
            <Button Content="Save as New (1)" Width="115" Height="26" IsDefault="True" Click="SaveAsNew_Click" Background="#2563EB" Foreground="#FFFFFF" FontWeight="SemiBold" BorderThickness="0" Margin="0,0,6,0"/>
            <Button Content="Open File" Width="80" Height="26" Click="OpenFile_Click" Background="#F8F9FA" BorderBrush="#CBD5E1" FontWeight="Regular" Foreground="#1E293B" Margin="0,0,6,0"/>
            <Button Content="Cancel" Width="70" Height="26" IsCancel="True" Click="Cancel_Click" Background="#F8F9FA" BorderBrush="#CBD5E1" FontWeight="Regular" Foreground="#1E293B"/>
        </StackPanel>
    </Grid>
</Window>
