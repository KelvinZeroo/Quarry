<Window x:Class="QuarryApp.Windows.DownloadProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:ThemeManager.IsThemeAware="True"
        Title="Download Progress" Height="430" Width="520"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        FontFamily="Manrope, Segoe UI Variable Text, Segoe UI, sans-serif" FontSize="12">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0. File Details Ledger -->
            <RowDefinition Height="Auto"/> <!-- 1. Main Progress Bar -->
            <RowDefinition Height="Auto"/> <!-- 2. 8-Chunk Segments -->
            <RowDefinition Height="*"/>    <!-- 3. Connection Activity Log -->
            <RowDefinition Height="Auto"/> <!-- 4. Bottom Options & Buttons -->
        </Grid.RowDefinitions>

        <!-- 0. File Details Ledger -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="115"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="File Name:" FontWeight="SemiBold" Foreground="#475569" FontSize="11.5"/>
                <TextBlock x:Name="FileNameText" Grid.Row="0" Grid.Column="1" Text="—" FontWeight="Bold" Foreground="#1E293B" TextTrimming="CharacterEllipsis"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Status:" FontWeight="SemiBold" Foreground="#475569" FontSize="11.5"/>
                <TextBlock x:Name="StatusText" Grid.Row="2" Grid.Column="1" Text="Downloading..." Foreground="#2563EB" FontWeight="Medium"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="File Size / Progress:" FontWeight="SemiBold" Foreground="#475569" FontSize="11.5"/>
                <TextBlock x:Name="SizeProgressText" Grid.Row="4" Grid.Column="1" Text="0 MB of 0 MB (0%)" Foreground="#1E293B"/>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="Transfer Rate:" FontWeight="SemiBold" Foreground="#475569" FontSize="11.5"/>
                <TextBlock x:Name="TransferRateText" Grid.Row="6" Grid.Column="1" Text="—" FontWeight="Bold" Foreground="#059669"/>

                <TextBlock Grid.Row="8" Grid.Column="0" Text="Time Left:" FontWeight="SemiBold" Foreground="#475569" FontSize="11.5"/>
                <TextBlock x:Name="TimeLeftText" Grid.Row="8" Grid.Column="1" Text="—" Foreground="#1E293B"/>
            </Grid>
        </Border>

        <!-- 1. Main Progress Bar -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <ProgressBar x:Name="MainProgressBar" Height="20" Minimum="0" Maximum="100" Value="0" Style="{StaticResource ClassicXpBlueProgressBarStyle}"/>
            <TextBlock x:Name="PercentText" Text="0%" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="11" Foreground="#0F172A"/>
        </Grid>

        <!-- 2. Classic IDM 8-Connection Segment Chunk Visualizer -->
        <GroupBox Grid.Row="2" Header="Multi-Thread Connection Segments (8 Parallel Chunks)" Padding="6,6" Margin="0,0,0,10" BorderBrush="#CBD5E1" Foreground="#475569" FontSize="10.5">
            <UniformGrid Columns="8" Height="15" Margin="2,2">
                <ProgressBar x:Name="Chunk1" Margin="1,0" Minimum="0" Maximum="100" Value="0" Style="{StaticResource ClassicXpBlueProgressBarStyle}"/>
                <ProgressBar x:Name="Chunk2" Margin="1,0" Minimum="0" Maximum="100" Value="0" Style="{StaticResource ClassicXpBlueProgressBarStyle}"/>
                <ProgressBar x:Name="Chunk3" Margin="1,0" Minimum="0" Maximum="100" Value="0" Style="{StaticResource ClassicXpBlueProgressBarStyle}"/>
                <ProgressBar x:Name="Chunk4" Margin="1,0" Minimum="0" Maximum="100" Value="0" Style="{StaticResource ClassicXpBlueProgressBarStyle}"/>
                <ProgressBar x:Name="Chunk5" Margin="1,0" Minimum="0" Maximum="100" Value="0" Style="{StaticResource ClassicXpBlueProgressBarStyle}"/>
                <ProgressBar x:Name="Chunk6" Margin="1,0" Minimum="0" Maximum="100" Value="0" Style="{StaticResource ClassicXpBlueProgressBarStyle}"/>
                <ProgressBar x:Name="Chunk7" Margin="1,0" Minimum="0" Maximum="100" Value="0" Style="{StaticResource ClassicXpBlueProgressBarStyle}"/>
                <ProgressBar x:Name="Chunk8" Margin="1,0" Minimum="0" Maximum="100" Value="0" Style="{StaticResource ClassicXpBlueProgressBarStyle}"/>
            </UniformGrid>
        </GroupBox>

        <!-- 3. Parallel Download Log / Stream Activity -->
        <GroupBox Grid.Row="3" Header="Connection &amp; Download Log" Padding="6,4" Margin="0,0,0,10" BorderBrush="#E2E8F0" Foreground="#475569" FontSize="10.5">
            <TextBox x:Name="LogTextBox"
                     IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto"
                     Background="#FFFFFF"
                     BorderThickness="0"
                     FontFamily="Consolas, monospace"
                     FontSize="10.5"
                     Foreground="#334155"
                     TextWrapping="Wrap"/>
        </GroupBox>

        <!-- 4. Bottom Actions (IDM Style) -->
        <DockPanel Grid.Row="4" LastChildFill="False">
            <CheckBox x:Name="CloseOnDoneCheck" DockPanel.Dock="Left" Content="Close dialog when completed" VerticalAlignment="Center" FontSize="11" Foreground="#475569"/>

            <!-- Action Buttons for Downloading State -->
            <StackPanel x:Name="DownloadingActions" DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="PauseButton" Content="Pause" Width="75" Height="26" Click="Pause_Click" Background="#F8F9FA" BorderBrush="#CBD5E1" FontWeight="Regular" Foreground="#1E293B" Margin="0,0,6,0"/>
                <Button Content="Cancel" Width="75" Height="26" Click="Cancel_Click" Background="#F8F9FA" BorderBrush="#CBD5E1" FontWeight="Regular" Foreground="#1E293B" Margin="0,0,6,0"/>
                <Button Content="Hide" Width="75" Height="26" Click="Hide_Click" Background="#F8F9FA" BorderBrush="#CBD5E1" FontWeight="Regular" Foreground="#1E293B"/>
            </StackPanel>

            <!-- Action Buttons for Completed State -->
            <StackPanel x:Name="CompletedActions" DockPanel.Dock="Right" Orientation="Horizontal" Visibility="Collapsed">
                <Button Content="Open / Play" Width="90" Height="26" Click="Open_Click" Background="#2563EB" Foreground="#FFFFFF" FontWeight="SemiBold" BorderThickness="1" BorderBrush="#1D4ED8" Margin="0,0,6,0"/>
                <Button Content="Open Folder" Width="90" Height="26" Click="OpenFolder_Click" Background="#F8F9FA" BorderBrush="#CBD5E1" FontWeight="Regular" Foreground="#1E293B" Margin="0,0,6,0"/>
                <Button Content="Close" Width="70" Height="26" Click="Close_Click" Background="#F8F9FA" BorderBrush="#CBD5E1" FontWeight="Regular" Foreground="#1E293B"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
