<Window x:Class="QuarryApp.Windows.RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rename Downloaded File" Height="160" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Manrope, Segoe UI, sans-serif" FontSize="12">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Enter new file name:" Foreground="#334155" FontWeight="Medium" Margin="0,0,0,8"/>
        <TextBox x:Name="NameTextBox" Grid.Row="1" Height="26" Padding="6,0" VerticalContentAlignment="Center" Background="#FFFFFF" BorderBrush="#CBD5E1"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="75" Height="26" IsDefault="True" Click="Ok_Click" Background="#2563EB" Foreground="#FFFFFF" FontWeight="SemiBold" BorderThickness="1" BorderBrush="#1D4ED8" Margin="0,0,6,0"/>
            <Button Content="Cancel" Width="75" Height="26" IsCancel="True" Click="Cancel_Click" Background="#F8F9FA" BorderBrush="#CBD5E1" FontWeight="Regular" Foreground="#1E293B"/>
        </StackPanel>
    </Grid>
</Window>
