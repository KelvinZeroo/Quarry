<Window x:Class="QuarryApp.Windows.AddDownloadDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:ThemeManager.IsThemeAware="True"
        Title="Add Download — Quarry" Height="400" Width="600"
        MinWidth="540" MinHeight="360"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="#F1F5F9"
        FontFamily="Manrope, Segoe UI Variable Text, Segoe UI, sans-serif" FontSize="12">

    <Grid Margin="16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Main Form Card -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Header -->
                    <TextBlock Text="New Download" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,12"/>

                    <!-- 0. Source URL -->
                    <TextBlock Text="Source URL / Magnet Link:" FontWeight="Medium" Foreground="#334155" Margin="0,0,0,5"/>
                    <TextBox x:Name="UrlTextBox" Height="30" Padding="8,0" VerticalContentAlignment="Center" Background="#F8FAFC" BorderBrush="#CBD5E1" Margin="0,0,0,12" TextChanged="UrlTextBox_TextChanged"/>

                    <!-- 1. Download Mode Switcher -->
                    <TextBlock Text="Download Mode:" FontWeight="Medium" Foreground="#334155" Margin="0,0,0,6"/>
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,12">
                        <WrapPanel VerticalAlignment="Center">
                            <RadioButton x:Name="ModeAutoRadio" Content="Auto-Detect" IsChecked="True" GroupName="DownloadModeGroup" Margin="0,0,16,0" Checked="DownloadMode_Changed" Foreground="#1E293B" FontWeight="Medium" Cursor="Hand"/>
                            <RadioButton x:Name="ModeVideoRadio" Content="Video Stream" GroupName="DownloadModeGroup" Margin="0,0,16,0" Checked="DownloadMode_Changed" Foreground="#1E293B" FontWeight="Medium" Cursor="Hand"/>
                            <RadioButton x:Name="ModeScrapeRadio" Content="Scrape Images" GroupName="DownloadModeGroup" Margin="0,0,16,0" Checked="DownloadMode_Changed" Foreground="#1E293B" FontWeight="Medium" Cursor="Hand"/>
                            <RadioButton x:Name="ModeDirectRadio" Content="Direct File" GroupName="DownloadModeGroup" Checked="DownloadMode_Changed" Foreground="#1E293B" FontWeight="Medium" Cursor="Hand"/>
                        </WrapPanel>
                    </Border>

                    <!-- 2. Category & Save Path in 2-Columns -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Category -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Category:" FontWeight="Medium" Foreground="#334155" Margin="0,0,0,5"/>
                            <ComboBox x:Name="CategoryComboBox" Height="30" SelectionChanged="CategoryComboBox_SelectionChanged" SelectedIndex="0">
                                <ComboBoxItem Content="General"/>
                                <ComboBoxItem Content="Video"/>
                                <ComboBoxItem Content="Music"/>
                                <ComboBoxItem Content="Documents"/>
                                <ComboBoxItem Content="Compressed"/>
                                <ComboBoxItem Content="Programs"/>
                                <ComboBoxItem Content="Images"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Save Location -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Save Location:" FontWeight="Medium" Foreground="#334155" Margin="0,0,0,5"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="75"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="SaveAsTextBox" Grid.Column="0" Height="30" Padding="8,0" VerticalContentAlignment="Center" Background="#F8FAFC" BorderBrush="#CBD5E1"/>
                                <Button Grid.Column="2" Content="Browse..." Height="30" Click="BrowseFile_Click" Background="#F1F5F9" BorderBrush="#CBD5E1" FontWeight="Medium" ToolTip="Browse target location"/>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- 3. Video Stream Quality (Visible for Video Stream Mode) -->
                    <Grid x:Name="QualityGrid" Margin="0,0,0,10" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Stream Quality:" VerticalAlignment="Center" FontWeight="Medium" Foreground="#334155"/>
                        <ComboBox x:Name="QualityComboBox" Grid.Column="2" Height="30" DisplayMemberPath="DisplayText" SelectionChanged="QualityComboBox_SelectionChanged"/>
                        <TextBlock x:Name="ProbingIndicator" Grid.Column="3" Text=" probing stream..." VerticalAlignment="Center" Foreground="#2563EB" FontSize="11" Margin="6,0,0,0" Visibility="Collapsed"/>
                    </Grid>

                    <!-- 4. Scrape Images Limit (Visible for Scrape Mode) -->
                    <Grid x:Name="ScrapeOptionsGrid" Margin="0,0,0,10" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Media Limit:" VerticalAlignment="Center" FontWeight="Medium" Foreground="#334155"/>
                        <ComboBox x:Name="ScrapeLimitComboBox" Grid.Column="2" Height="30" SelectedIndex="0">
                            <ComboBoxItem Content="All Discovered Media (No limit)"/>
                            <ComboBoxItem Content="First 50 Images"/>
                            <ComboBoxItem Content="First 100 Images"/>
                            <ComboBoxItem Content="First 250 Images"/>
                        </ComboBox>
                    </Grid>

                    <!-- 5. Detection & Size Info -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,2,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Target: " Foreground="#64748B" FontWeight="Medium"/>
                            <TextBlock x:Name="DetectionModeTitle" Text="Direct Web Download" Foreground="#1E293B" FontWeight="SemiBold" Margin="0,0,12,0"/>
                            <TextBlock x:Name="FileSizeLabel" Text="" Foreground="#2563EB" FontWeight="SemiBold"/>
                            <TextBlock x:Name="FileFormatBadge" Text="" Visibility="Collapsed"/>
                            <TextBlock x:Name="DetectionModeSubtitle" Text="" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Footer Action Buttons -->
        <DockPanel Grid.Row="1" LastChildFill="False">
            <CheckBox x:Name="AutoStartCheck" DockPanel.Dock="Left" Content="Start download immediately" IsChecked="True" VerticalAlignment="Center" FontSize="11.5" Foreground="#475569"/>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Download Later" Width="110" Height="30" Click="DownloadLater_Click" Background="#FFFFFF" BorderBrush="#CBD5E1" FontWeight="Medium" Foreground="#334155" Margin="0,0,8,0"/>
                <Button Content="Start Download" Width="120" Height="30" IsDefault="True" Click="StartDownload_Click" Background="#2563EB" Foreground="#FFFFFF" FontWeight="SemiBold" BorderThickness="0" Margin="0,0,8,0"/>
                <Button Content="Cancel" Width="75" Height="30" IsCancel="True" Click="Cancel_Click" Background="#F1F5F9" BorderBrush="#CBD5E1" FontWeight="Medium" Foreground="#334155"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
