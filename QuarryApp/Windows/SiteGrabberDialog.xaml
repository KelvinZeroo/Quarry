<Window x:Class="QuarryApp.Windows.SiteGrabberDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quarry Site Grabber Wizard" Height="320" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Manrope, Segoe UI Variable Text, Segoe UI, sans-serif" FontSize="12">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Enter a website root or gallery URL to deep crawl and download all discovered media files:" TextWrapping="Wrap" Foreground="#475569" Margin="0,0,0,14" LineHeight="18"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,14">
            <TextBlock Text="Start URL:" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,5"/>
            <TextBox x:Name="StartUrlTextBox" Height="30" Padding="8,4" Background="White" BorderBrush="#CBD5E1" FontSize="12"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,14">
            <TextBlock Text="Max Discovery Files Cap:" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,5"/>
            <TextBox x:Name="MaxScanTextBox" Height="30" Padding="8,4" Background="White" BorderBrush="#CBD5E1" Text="2000" FontSize="12"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Start Site Grabber" Width="140" Height="32" IsDefault="True" Click="Start_Click" Background="#7C3AED" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Margin="0,0,10,0"/>
            <Button Content="Cancel" Width="85" Height="32" IsCancel="True" Click="Cancel_Click" Background="#E2E8F0" BorderBrush="#CBD5E1" FontWeight="Medium" Foreground="#334155"/>
        </StackPanel>
    </Grid>
</Window>
